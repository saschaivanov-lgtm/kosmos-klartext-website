---
import BaseLayout from '@/layouts/BaseLayout.astro'; import ContentCard from '@/components/ContentCard.astro'; import { loadGraph } from '@/lib/graph';
const graph = await loadGraph();
---
<BaseLayout title="Wissen" description="Kanonische, quellenbasierte Wissenseinträge von Kosmos Klartext."><header class="page-hero"><div class="page-hero-inner shell"><span class="eyebrow">Kanonisches Wissen</span><h1>Fragen präzise erklären</h1><p class="dek">Jeder Eintrag trennt gesicherten Stand, Quellenlage und offene Grenzen. Überarbeitete Kandidaten warten vor einer Veröffentlichung auf menschliche Fachfreigabe.</p></div></header><section class="section shell"><div class="catalog-toolbar"><strong>{graph.knowledge.length} Wissenseinträge im V1-Freigabekandidaten</strong><a href="/suche/?type=knowledge">Filtern und suchen →</a></div><div class="mixed-grid">{graph.knowledge.map((entry) => <ContentCard entry={entry} headingLevel={2} />)}</div></section></BaseLayout>
