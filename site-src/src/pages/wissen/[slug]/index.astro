---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ReviewStamp from '@/components/ReviewStamp.astro';
import SourceBlock from '@/components/SourceBlock.astro';
import RelatedContent from '@/components/RelatedContent.astro';
import { loadGraph } from '@/lib/graph';
import { isReleased } from '@/lib/release-policy';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge', ({ data }) => isReleased('knowledge', data.uid));
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const graph = await loadGraph();
const sourceItems = graph.sourcesFor(entry.data.uid);
const related = graph.linked(entry.data.uid);
const updated = new Intl.DateTimeFormat('de-DE', { dateStyle: 'long' }).format(new Date(`${entry.data.updatedAt}T12:00:00Z`));
---

<BaseLayout title={entry.data.title} description={entry.data.summary} image={entry.data.heroImage?.src} pageType="article">
  <header class="page-hero">
    <div class="page-hero-inner shell">
      <Breadcrumbs items={[{ label: 'Start', href: '/' }, { label: 'Wissen' }, { label: entry.data.title }]} />
      <span class="eyebrow">Wissenseintrag · {entry.data.scientificStatus === 'active_research' ? 'Aktive Forschung' : entry.data.scientificStatus === 'mixed' ? 'Gesichertes & offene Fragen' : 'Etablierter Wissensstand'}</span>
      <h1>{entry.data.title}</h1>
      <p class="dek">{entry.data.dek}</p>
      <div class="meta-row"><span>{entry.data.readingMinutes} Min. Lesezeit</span><span>Aktualisiert {updated}</span><span>{sourceItems.length} Quellen</span></div>
    </div>
  </header>
  <section class="section shell">
    <div class="article-shell">
      <article class="prose">
        {entry.data.heroImage && <figure class="hero-figure">
          <img src={entry.data.heroImage.src} alt={entry.data.heroImage.alt} width="1280" height="720" />
        </figure>}
        {entry.data.sourceGap && <div class="limit-note"><strong>Offener Quellen-Schritt</strong><br />{entry.data.sourceGap}</div>}
        <Content />
      </article>
      <aside class="article-aside">
        <ReviewStamp review={entry.data.review} />
        <nav class="aside-card" aria-label="Inhalt dieses Wissenseintrags">
          <h2>Auf dieser Seite</h2>
          <ol>{headings.filter((heading) => heading.depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
        </nav>
      </aside>
    </div>
    <SourceBlock items={sourceItems} />
    <RelatedContent items={related} />
  </section>
</BaseLayout>
