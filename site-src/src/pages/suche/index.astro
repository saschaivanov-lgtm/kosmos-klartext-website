---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Suche" description="Website-interne Volltextsuche im Kosmos-Klartext-Wissensnetz."><header class="page-hero"><div class="page-hero-inner shell"><span class="eyebrow">Website-interne Suche</span><h1>Wissensnetz durchsuchen</h1><p class="dek">Volltextsuche mit Facetten nach Inhaltstyp und wissenschaftlichem Status – ohne Tracking und ohne externen Dienst.</p></div></header><section class="section shell search-app" data-search-app><form class="search-form" role="search"><label for="search-query">Suchbegriff</label><div><input id="search-query" name="q" type="search" autocomplete="off" placeholder="Zum Beispiel Licht, Quarks oder Schwarzes Loch"/><button class="button primary" type="submit">Suchen</button></div><fieldset><legend>Inhaltstyp</legend><label><input type="checkbox" name="type" value="knowledge"/> Wissen</label><label><input type="checkbox" name="type" value="video"/> Videos</label><label><input type="checkbox" name="type" value="source_canonical"/> Quellen</label><label><input type="checkbox" name="type" value="theme_world"/> Themenwelten</label><label><input type="checkbox" name="type" value="research_project"/> Projekte</label></fieldset></form><p class="search-status" aria-live="polite">Suchindex wird geladen …</p><div class="search-results"></div></section></BaseLayout>
<script>
  // @ts-nocheck
  const app=document.querySelector('[data-search-app]');
  if(app){
    const form=app.querySelector('form'); const input=app.querySelector('input[type="search"]'); const status=app.querySelector('.search-status'); const results=app.querySelector('.search-results'); let index=[];
    const esc=(value)=>value.replace(/[&<>"']/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
    function render(){const term=input.value.trim().toLocaleLowerCase('de'); const types=[...form.querySelectorAll('input[name="type"]:checked')].map((item)=>item.value); const hits=index.filter((item)=>(!term||item.text.toLocaleLowerCase('de').includes(term))&&(!types.length||types.includes(item.type))); status.textContent=`${hits.length} Treffer`; results.innerHTML=hits.slice(0,100).map((item)=>`<article class="search-result"><span class="eyebrow">${esc(item.typeLabel)}</span><h2><a href="${item.url}">${esc(item.title)}</a></h2><p>${esc(item.summary)}</p></article>`).join('')||'<p>Keine passenden Inhalte gefunden.</p>'; const url=new URL(location.href); term?url.searchParams.set('q',input.value):url.searchParams.delete('q'); history.replaceState({},'',url);}
    fetch('/search-index.json').then((response)=>response.json()).then((data)=>{index=data; input.value=new URLSearchParams(location.search).get('q')??''; render();}).catch(()=>{status.textContent='Der Suchindex konnte nicht geladen werden.'}); form.addEventListener('submit',(event)=>{event.preventDefault();render();}); form.addEventListener('change',render); input.addEventListener('input',render);
  }
</script>
