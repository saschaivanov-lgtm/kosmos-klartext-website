---
import { getCollection, render } from 'astro:content'; import BaseLayout from '@/layouts/BaseLayout.astro'; import Breadcrumbs from '@/components/Breadcrumbs.astro'; import ReviewStamp from '@/components/ReviewStamp.astro'; import RelatedContent from '@/components/RelatedContent.astro'; import { loadGraph } from '@/lib/graph'; import { isReleased } from '@/lib/release-policy';
export async function getStaticPaths(){return (await getCollection('cooperations', ({ data }) => isReleased('cooperations', data.uid))).map((entry)=>({params:{slug:entry.data.slug},props:{entry}}));} const {entry}=Astro.props; const {Content}=await render(entry); const graph=await loadGraph();
---
<BaseLayout title={entry.data.title} description={entry.data.summary} pageType="article"><header class="page-hero warning-hero"><div class="page-hero-inner shell"><Breadcrumbs items={[{label:'Start',href:'/'},{label:'Projekte',href:'/projekte/'},{label:entry.data.title}]}/><span class="eyebrow">Externe Hypothese · außerhalb des Konsenses</span><h1>{entry.data.title}</h1><p class="dek">{entry.data.summary}</p></div></header><section class="section shell"><div class="consensus-note"><strong>Wichtige Einordnung</strong><p>{entry.data.consensusNote}</p></div><div class="article-shell"><article class="prose"><Content/></article><aside class="article-aside"><ReviewStamp review={entry.data.review}/></aside></div><RelatedContent items={graph.linked(entry.data.uid)}/></section></BaseLayout>
