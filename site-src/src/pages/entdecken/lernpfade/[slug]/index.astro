---
import { getCollection, render } from 'astro:content'; import BaseLayout from '@/layouts/BaseLayout.astro'; import Breadcrumbs from '@/components/Breadcrumbs.astro'; import ReviewStamp from '@/components/ReviewStamp.astro'; import { loadGraph, routeFor, type GraphEntry } from '@/lib/graph'; import { isReleased } from '@/lib/release-policy';
export async function getStaticPaths(){ return (await getCollection('learningPaths', ({ data }) => isReleased('learningPaths', data.uid))).map((entry)=>({params:{slug:entry.data.slug},props:{entry}})); }
const { entry }=Astro.props; const { Content }=await render(entry); const graph=await loadGraph(); const steps=entry.data.knowledgeIds.map((uid)=>graph.byUid.get(uid)).filter((item): item is GraphEntry => Boolean(item));
---
<BaseLayout title={entry.data.title} description={entry.data.summary}><header class="page-hero"><div class="page-hero-inner shell"><Breadcrumbs items={[{label:'Start',href:'/'},{label:'Entdecken',href:'/entdecken/'},{label:entry.data.title}]}/><span class="eyebrow">Kuratierter Lernpfad</span><h1>{entry.data.title}</h1><p class="dek">{entry.data.summary}</p></div></header><section class="section shell"><div class="article-shell"><article class="prose"><Content/><ol class="path-steps">{steps.map((item,index)=><li><span>{String(index+1).padStart(2,'0')}</span><div><h2><a href={routeFor(item)}>{item.data.title}</a></h2><p>{item.data.summary}</p></div></li>)}</ol></article><aside class="article-aside"><ReviewStamp review={entry.data.review}/></aside></div></section></BaseLayout>
