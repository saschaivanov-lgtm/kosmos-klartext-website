---
import { getCollection, render } from 'astro:content'; import BaseLayout from '@/layouts/BaseLayout.astro'; import Breadcrumbs from '@/components/Breadcrumbs.astro'; import ContentCard from '@/components/ContentCard.astro'; import { loadGraph } from '@/lib/graph'; import { isReleased } from '@/lib/release-policy';
export async function getStaticPaths(){ return (await getCollection('topics', ({ data }) => isReleased('topics', data.uid))).map((entry)=>({params:{slug:entry.data.slug},props:{entry}})); }
const { entry }=Astro.props; const { Content }=await render(entry); const graph=await loadGraph(); const knowledge=graph.knowledge.filter((item)=>item.data.topicIds.includes(entry.data.uid)); const videos=graph.videos.filter((item)=>item.data.topicIds.includes(entry.data.uid));
---
<BaseLayout title={entry.data.title} description={entry.data.summary}><header class="page-hero"><div class="page-hero-inner shell"><Breadcrumbs items={[{label:'Start',href:'/'},{label:'Entdecken',href:'/entdecken/'},{label:entry.data.title}]}/><span class="eyebrow">Thema</span><h1>{entry.data.title}</h1><p class="dek">{entry.data.summary}</p><div class="meta-row"><span>{knowledge.length} Erklärungen</span><span>{videos.length} Videos</span></div></div></header><section class="section shell"><div class="prose"><Content /></div><div class="section-heading"><h2>Wissen</h2></div><div class="mixed-grid">{knowledge.map((item)=><ContentCard entry={item}/>)}</div>{videos.length>0&&<><div class="section-heading spaced"><h2>Videos</h2></div><div class="mixed-grid">{videos.map((item)=><ContentCard entry={item}/>)}</div></>}</section></BaseLayout>
