---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ReviewStamp from '@/components/ReviewStamp.astro';
import ContentCard from '@/components/ContentCard.astro';
import { loadGraph } from '@/lib/graph';
import { isReleased } from '@/lib/release-policy';

export async function getStaticPaths() {
  const entries = await getCollection('sources', ({ data }) => isReleased('sources', data.uid));
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const graph = await loadGraph();
const references = graph.referencesFor(entry.data.uid);
const kindLabels = { paper: 'Fachartikel', book: 'Buch', book_chapter: 'Buchkapitel', reference_work: 'Lehr- und Nachschlagewerk', technical_report: 'Technischer Bericht', official_background: 'Offizieller wissenschaftlicher Hintergrund' };
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <header class="page-hero source-hero">
    <div class="page-hero-inner shell">
      <Breadcrumbs items={[{ label: 'Start', href: '/' }, { label: 'Quellen' }, { label: entry.data.title }]} />
      <span class="eyebrow">Kanonische Quelle · {kindLabels[entry.data.kind]}</span>
      <h1>{entry.data.title}</h1>
      <p class="dek">{entry.data.authors.join(', ')} · {entry.data.year}</p>
    </div>
  </header>
  <section class="section shell">
    <div class="article-shell">
      <article>
        <div class="source-card">
          <dl>
            <dt>Autor:innen</dt><dd>{entry.data.authors.join(', ')}</dd>
            <dt>Jahr</dt><dd>{entry.data.year}</dd>
            <dt>Publikation</dt><dd>{entry.data.publisher}</dd>
            {entry.data.identifiers && <><dt>Identifikator</dt><dd>{Object.entries(entry.data.identifiers).map(([key, value]) => `${key.toUpperCase()}: ${value}`).join(' · ')}</dd></>}
            <dt>Original</dt><dd><a href={entry.data.url} rel="external">Quelle öffnen <span aria-hidden="true">↗</span></a></dd>
          </dl>
        </div>
        <div class="prose">
          <h2>Wofür diese Quelle verwendet wird</h2>
          <p>{entry.data.summary}</p>
          <div class="limit-note"><strong>Grenzen der Quelle</strong><br />{entry.data.limits}</div>
        </div>
      </article>
      <aside class="article-aside"><ReviewStamp review={entry.data.review} /></aside>
    </div>
    <section class="related-section" aria-labelledby="used-heading">
      <div class="section-heading"><span class="eyebrow">Automatischer Rückverweis</span><h2 id="used-heading">Verwendet in</h2><p>Diese Liste entsteht aus den Content-Source-Beziehungen – nicht aus manuell gepflegten Seitentexten.</p></div>
      <div class="mixed-grid">{references.map(({ content }) => <ContentCard entry={content} />)}</div>
    </section>
  </section>
</BaseLayout>
