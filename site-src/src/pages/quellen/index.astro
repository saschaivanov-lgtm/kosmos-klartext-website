---
import BaseLayout from '@/layouts/BaseLayout.astro'; import ContentCard from '@/components/ContentCard.astro'; import { loadGraph } from '@/lib/graph';
const graph = await loadGraph();
---
<BaseLayout title="Literatur & Quellen" description="Der kanonische Quellenkatalog von Kosmos Klartext mit Verwendungen und Grenzen."><header class="page-hero"><div class="page-hero-inner shell"><span class="eyebrow">Quellentransparenz</span><h1>Literatur & Quellen</h1><p class="dek">Eine Quelle wird einmal kanonisch gespeichert und erscheint automatisch an allen verknüpften Inhalten.</p></div></header><section class="section shell"><div class="catalog-toolbar"><strong>{graph.sources.length} kanonische Datensätze</strong><a href="/transparenz/quellenpolitik/">Quellenpolitik lesen →</a></div><div class="mixed-grid">{graph.sources.map((entry) => <ContentCard entry={entry} headingLevel={2} />)}</div></section></BaseLayout>
