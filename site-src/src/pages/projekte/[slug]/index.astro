---
import { getCollection, render } from 'astro:content'; import BaseLayout from '@/layouts/BaseLayout.astro'; import Breadcrumbs from '@/components/Breadcrumbs.astro'; import ReviewStamp from '@/components/ReviewStamp.astro'; import SourceBlock from '@/components/SourceBlock.astro'; import RelatedContent from '@/components/RelatedContent.astro'; import { loadGraph } from '@/lib/graph'; import { isReleased } from '@/lib/release-policy';
export async function getStaticPaths(){return (await getCollection('projects', ({ data }) => isReleased('projects', data.uid))).map((entry)=>({params:{slug:entry.data.slug},props:{entry}}));} const {entry}=Astro.props; const {Content}=await render(entry); const graph=await loadGraph();
---
<BaseLayout title={entry.data.title} description={entry.data.summary} pageType="article"><header class="page-hero"><div class="page-hero-inner shell"><Breadcrumbs items={[{label:'Start',href:'/'},{label:'Projekte',href:'/projekte/'},{label:entry.data.title}]}/><span class="eyebrow">Wissenschaftskommunikationsprojekt</span><h1>{entry.data.title}</h1><p class="dek">{entry.data.summary}</p><div class="meta-row"><span>{entry.data.statusLabel}</span></div></div></header><section class="section shell"><div class="article-shell"><article class="prose"><Content/></article><aside class="article-aside"><ReviewStamp review={entry.data.review}/><div class="aside-card"><h2>Rollenklärung</h2><p>Dieses Projekt dokumentiert Recherche und Vermittlung. Es behauptet keine eigene Grundlagenforschung.</p></div></aside></div><SourceBlock items={graph.sourcesFor(entry.data.uid)}/><RelatedContent items={graph.linked(entry.data.uid)}/></section></BaseLayout>
