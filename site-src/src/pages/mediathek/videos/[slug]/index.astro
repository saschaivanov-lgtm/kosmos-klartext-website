---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import VideoPlayer from '@/components/VideoPlayer.astro';
import ReviewStamp from '@/components/ReviewStamp.astro';
import SourceBlock from '@/components/SourceBlock.astro';
import RelatedContent from '@/components/RelatedContent.astro';
import { loadGraph } from '@/lib/graph';
import { isReleased } from '@/lib/release-policy';

export async function getStaticPaths() {
  const entries = await getCollection('videos', ({ data }) => isReleased('videos', data.uid));
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const graph = await loadGraph();
const sourceItems = graph.sourcesFor(entry.data.uid);
const related = graph.linked(entry.data.uid);
const published = entry.data.publishedAt ? new Intl.DateTimeFormat('de-DE', { dateStyle: 'long' }).format(new Date(`${entry.data.publishedAt}T12:00:00Z`)) : undefined;
---

<BaseLayout title={entry.data.title} description={entry.data.dek}>
  <header class="page-hero">
    <div class="page-hero-inner shell">
      <Breadcrumbs items={[{ label: 'Start', href: '/' }, { label: 'Mediathek' }, { label: entry.data.title }]} />
      <span class="eyebrow">Video · {entry.data.pageMode === 'deep' ? 'Vertiefte Begleitseite' : 'Katalogseite'}</span>
      <h1>{entry.data.title}</h1>
      <p class="dek">{entry.data.dek}</p>
      <div class="meta-row">{published && <span>Veröffentlicht {published}</span>}<span>{entry.data.durationDisplay ?? 'Laufzeit nicht verifiziert'}</span><span>{entry.data.pageMode === 'deep' ? 'Vertieft' : 'Metadaten'}</span></div>
    </div>
  </header>
  <section class="video-wrap shell">
    <VideoPlayer platformId={entry.data.platformId} title={entry.data.title} thumbnail={entry.data.thumbnail} />
  </section>
  <section class="section shell">
    <div class="article-shell">
      <article class="prose">
        <Content />
        <h2>Kapitel</h2>
        {entry.data.chapters.length > 0 ? <ol class="chapter-list">
          {entry.data.chapters.map((chapter) => <li><time>{chapter.time}</time><span>{chapter.title}</span></li>)}
        </ol> : <p class="empty-note">Noch keine verifizierten Kapitelmarken hinterlegt. Angaben werden nicht geschätzt.</p>}
      </article>
      <aside class="article-aside">
        <ReviewStamp review={entry.data.review} />
        <div class="aside-card"><h2>Kein Doppelinhalt</h2><p>Die vertiefende Erklärung liegt als eigenständiger Wissenseintrag vor und kann unabhängig vom Video aktualisiert werden.</p></div>
      </aside>
    </div>
    <SourceBlock items={sourceItems} />
    <RelatedContent items={related} />
  </section>
</BaseLayout>
