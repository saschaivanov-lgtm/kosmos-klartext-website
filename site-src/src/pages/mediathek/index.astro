---
import BaseLayout from '@/layouts/BaseLayout.astro'; import ContentCard from '@/components/ContentCard.astro'; import { loadGraph } from '@/lib/graph';
const graph = await loadGraph(); const deep = graph.videos.filter((item) => item.data.pageMode === 'deep'); const metadata = graph.videos.filter((item) => item.data.pageMode === 'metadata');
---
<BaseLayout title="Mediathek" description="Ausgewählte Videos von Kosmos Klartext, thematisch mit Wissen und Quellen verknüpft."><header class="page-hero"><div class="page-hero-inner shell"><span class="eyebrow">Mediathek</span><h1>Videos im Wissensnetz</h1><p class="dek">Der fokussierte Katalog ergänzt die drei Erklärungen. Videos bleiben ein Format der Plattform, nicht ihr strukturelles Zentrum.</p><div class="meta-row"><span>{graph.videos.length} Videos</span><span>{deep.length} vertiefte Begleitseiten</span></div></div></header><section class="section shell"><div class="section-heading"><h2>Vertiefte Begleitseiten</h2></div><div class="mixed-grid">{deep.map((entry) => <ContentCard entry={entry} />)}</div></section>{metadata.length > 0 && <section class="section shell"><div class="section-heading"><h2>Ergänzende Videoseiten</h2><p>Diese geprüften Kurzbeschreibungen erschließen weitere Videos des öffentlichen Katalogs.</p></div><div class="compact-list">{metadata.map((entry) => <a href={`/mediathek/videos/${entry.data.slug}/`}><strong>{entry.data.title}</strong>{entry.data.durationDisplay && <span>{entry.data.durationDisplay}</span>}</a>)}</div></section>}</BaseLayout>
