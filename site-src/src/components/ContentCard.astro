---
import { routeFor, typeLabel, type GraphEntry } from '@/lib/graph';
interface Props { entry: GraphEntry; eyebrow?: string; headingLevel?: 2 | 3 }
const { entry, eyebrow, headingLevel = 3 } = Astro.props;
const { title, summary, dek, type } = entry.data;
const Heading = `h${headingLevel}`;
---

<article class="content-card">
  <span class="eyebrow">{eyebrow ?? typeLabel(type)}</span>
  <Heading><a href={routeFor(entry)}>{title}</a></Heading>
  <p>{summary ?? dek}</p>
  <a class="text-link" href={routeFor(entry)}>Öffnen <span aria-hidden="true">→</span></a>
</article>
