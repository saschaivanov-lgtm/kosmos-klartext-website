---
interface Props {
  platformId: string;
  title: string;
  thumbnail: { src: string; alt: string };
}
const { platformId, title, thumbnail } = Astro.props;
---

<div class="video-consent" data-video={platformId} data-title={title}>
  <img src={thumbnail.src} alt={thumbnail.alt} width="1280" height="720" loading="eager" />
  <div class="video-overlay">
    <span class="eyebrow">Datenschutzfreundliche Einbettung</span>
    <p>Das Video wird erst nach deiner Zustimmung von YouTube geladen. Dabei können Daten wie deine IP-Adresse an YouTube/Google übermittelt werden. <a href="/datenschutz/#youtube">Mehr zum Datenschutz</a>.</p>
    <button class="button primary" type="button" data-load-video>Video laden</button>
    <a class="button ghost" href={`https://www.youtube.com/watch?v=${platformId}`} rel="external">Direkt auf YouTube <span aria-hidden="true">↗</span></a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((container) => {
    container.querySelector<HTMLButtonElement>('[data-load-video]')?.addEventListener('click', () => {
      const id = container.dataset.video;
      if (!id) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      frame.title = `YouTube-Video: ${container.dataset.title ?? 'Kosmos Klartext'}`;
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      frame.allowFullscreen = true;
      container.replaceChildren(frame);
      frame.focus();
    });
  });
</script>
