---
import { navigation } from '@/lib/release-policy';
const currentPath = Astro.url.pathname;
const items = navigation.map((item) => ({ href: item.path, label: item.label }));
---

<header class="site-header">
  <div class="prototype-bar" role="status">V1-Freigabekandidat · Indexierung gesperrt</div>
  <div class="header-inner shell">
    <a class="brand" href="/" aria-label="Kosmos Klartext – Startseite">
      <img class="brand-logo" src="/assets/brand/kk-logo-compact-384.jpg" alt="" width="384" height="384" />
      <span class="brand-copy"><strong>Kosmos Klartext</strong><small><span>Wissen.</span> Verstehen. <em>Staunen.</em></small></span>
    </a>
    <nav class="desktop-nav" aria-label="Hauptnavigation">
      {items.map((item) => (
        <a href={item.href} aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <details class="mobile-nav">
      <summary>Menü</summary>
      <nav aria-label="Mobile Hauptnavigation">
        {items.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>
