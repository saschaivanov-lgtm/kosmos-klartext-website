{
  "name": "kosmos-klartext-website",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev",
    "build": "pnpm validate && node scripts/run-astro.mjs check && node scripts/run-astro.mjs build && pnpm validate:dist && pnpm validate:a11y",
    "preview": "node scripts/run-astro.mjs preview",
    "validate": "node scripts/validate-content.mjs",
    "validate:dist": "node scripts/validate-dist-links.mjs",
    "validate:a11y": "node scripts/audit-static-a11y.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "astro": "7.3.5",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
